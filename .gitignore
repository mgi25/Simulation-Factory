# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environments
.venv/
venv/
env/

# Generated simulation output (replays, frames, videos)
output/
frames/
videos/
*.mp4

# Delivered cuts kept outside output/ so they survive a worktree being
# removed. The films are already covered by *.mp4; this keeps whatever
# else lands beside them (contact sheets, notes) out of the branch too.
exports/

# Iteration frames from the art labs: kept out of the branch on purpose,
# because they are the working set and change every render.
docs/validation/**/_preview/

# Godot
godot/.godot/
godot/android/
godot/export_presets.cfg

# IDE / editor
.vscode/
.idea/
*.swp

# OS
Thumbs.db
desktop.ini
.DS_Store

# Company OS runtime state: session packets, receipts and usage records. The
# state directory is always supplied by the caller, and none of it belongs in
# the branch.
state/

# Local credentials and OAuth state. Examples may be committed explicitly;
# real client files, environment files, and grants may not.
.env
.env.*
!.env.example
.secrets/
.company-os/
client_secret*.json
youtube-client*.json
youtube-token*.json
token.json
/company_os_records/
