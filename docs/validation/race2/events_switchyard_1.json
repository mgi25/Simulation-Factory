  "phases": [
   {
    "name": "start_scramble",
    "stages": [
     "head"
    ],
    "purpose": "release eight racers in one tick and destroy the bay order before the course narrows for the first time"
   },
   {
    "name": "first_mechanism",
    "stages": [
     "pan1",
     "corr1"
    ],
    "purpose": "four wheels at 6.2 rad/s in a 2.8-unit corridor - the biggest single reordering, and the earliest"
   },
   {
    "name": "recompression",
    "stages": [
     "pan2"
    ],
    "purpose": "a banked pan that erases the drum's gaps, so the next question is asked of a field that is level again"
   },
   {
    "name": "gate",
    "stages": [
     "corr2",
     "pan3"
    ],
    "purpose": "the one wheel that sweeps the whole channel; it is shut for about a third of every turn and a leader can be the one it catches"
   },
   {
    "name": "second_mechanism",
    "stages": [
     "corr3",
     "pan4",
     "corr4"
    ],
    "purpose": "two counter-turning wheels, then a slower pair - the deflection cancels and only the delay is left, which is what reorders"
   },
   {
    "name": "final_sprint",
    "stages": [
     "pan5",
     "sprint"
    ],
    "purpose": "one more bank to compress what the last wheels separated, then a straight fall with nothing on it"
   }
  ],
